{
  "id": "servas-ai.connector-geosphere-at",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "GeoSphere Austria Wetter & Klima",
  "description": "Aktuelle Messwerte, Klima-Tageswerte, Stationen und Punktvorhersagen über die offizielle GeoSphere Dataset API v1 (CC BY 4.0).",
  "author": "servas-ai",
  "categories": [
    "connector"
  ],
  "tags": [
    "opendata",
    "wetter",
    "klima",
    "at"
  ],
  "capabilities": [
    "agent.tools.register"
  ],
  "tools": [
    {
      "name": "datensaetze",
      "displayName": "GeoSphere Austria Wetter & Klima – datensaetze",
      "description": "Datensätze der Dataset-API listen",
      "command": "node bin/cli.js datensaetze --typ station --format json"
    },
    {
      "name": "stationen",
      "displayName": "GeoSphere Austria Wetter & Klima – stationen",
      "description": "Stationen eines Datensatzes",
      "command": "node bin/cli.js stationen --q linz --format json"
    },
    {
      "name": "aktuell",
      "displayName": "GeoSphere Austria Wetter & Klima – aktuell",
      "description": "Aktuelle TAWES-10-min-Messwerte",
      "command": "node bin/cli.js aktuell --stationen 11060,11035 --format json"
    },
    {
      "name": "klima",
      "displayName": "GeoSphere Austria Wetter & Klima – klima",
      "description": "Klima-Tageswerte (klima-v2-1d)",
      "command": "node bin/cli.js klima --station 56 --format json"
    },
    {
      "name": "vorhersage",
      "displayName": "GeoSphere Austria Wetter & Klima – vorhersage",
      "description": "Stündliche Punktvorhersage NWP 1 km",
      "command": "node bin/cli.js vorhersage --lat 48.3064 --lon 14.2861 --stunden 24 --format json"
    }
  ],
  "access": {
    "method": "official-api",
    "login": false,
    "apiKey": false,
    "endpoint": "https://dataset.api.hub.geosphere.at/v1",
    "protocol": "REST/GeoJSON",
    "rateLimit": "5/s, 240/h",
    "license": "CC BY 4.0",
    "robots": {
      "dataset.api.hub.geosphere.at": "kein robots.txt (404)",
      "data.hub.geosphere.at": "Disallow /api/ – nicht genutzt"
    }
  },
  "logo": "../logo.png",
