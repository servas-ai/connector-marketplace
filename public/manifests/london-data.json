{
  "id": "servas-ai.opencli-london-data",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "London Datastore (CKAN-kompatibel)",
  "description": "data.london.gov.uk CKAN API: Dataset-Suche und Dataset-Details (Titel, Organisation, Ressourcen). Ohne Login/Key.",
  "author": "servas-ai",
  "categories": [
    "connector",
    "opendata"
  ],
  "capabilities": [
    "agent.tools.register"
  ],
  "tools": [
    {
      "name": "datasets",
      "displayName": "datasets",
      "description": "london-data datasets",
      "command": "london-data-cli datasets"
    },
    {
      "name": "dataset",
      "displayName": "dataset",
      "description": "london-data dataset",
      "command": "london-data-cli dataset"
    }
  ],
  "skill": "SKILL.md",
  "proof": "PRUEFPROTOKOLL.md",
  "x-servas": {
    "schema": "servas.record.v1",
    "category": "opendata",
    "realtime": false,
    "source_url": "https://data.london.gov.uk/api/action/package_search",
    "access_chain": [
      "official_api",
      "dump",
      "json_endpoint",
      "html",
      "headless"
    ],
    "access_used": "official_api",
    "login": false,
    "rate_limit": "1 Request / 2 s pro Host",
    "robots_status": "ok",
    "robots": "data.london.gov.uk/robots.txt: Disallow nur /debug /manage/ /login /logout – /api/action/ nicht gesperrt. Drossel ≥2 s.",
    "tos": "Greater London Authority Datastore; Open Government Licence, Fair Use.",
    "logo": {
      "domain": "data.london.gov.uk",
      "chain": [
        "logo.dev",
        "brandfetch",
        "google",
        "duckduckgo",
        "iconhorse",
        "direct"
      ],
      "resolved": "https://www.google.com/s2/favicons?domain=data.london.gov.uk&sz=128",
      "fallback": "initials",
      "file": "assets/logos/data.london.gov.uk.png"
    },
    "interfaces": [
      "paperclip",
      "cli"
    ],
    "kpis": {
      "stabilitaet": 0.0,
      "latenz_ms": 0,
      "throughput_rps": 0,
      "captcha_rate": 0,
      "login": false,
      "api_version": "ckan-3",
      "last_scrape": null,
      "datenqualitaet": 0.0
    },
    "openui": {
      "card": {
        "title": "London Datastore (CKAN-kompatibel)",
        "subtitle": "opendata",
        "icon": "logo",
        "badges": [
          "robots_status",
          "login",
          "realtime"
        ]
      },
      "list": {
        "columns": [
          "id",
          "title"
        ]
      },
      "detail": {
        "fields": [
          "kpis",
          "access_chain",
          "robots",
          "source_url"
        ]
      }
    },
    "country": "GB",
    "ampel": "grün",
    "license": "OGL-UK-3.0",
    "logo_source": "favicon"
  }
}