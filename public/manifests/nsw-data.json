{
  "id": "servas-ai.opencli-nsw-data",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "NSW Open Data (CKAN)",
  "description": "data.nsw.gov.au CKAN API: Dataset-Suche und Dataset-Details (Titel, Organisation, Ressourcen). Ohne Login/Key.",
  "author": "servas-ai",
  "categories": [
    "connector",
    "opendata"
  ],
  "capabilities": [
    "agent.tools.register"
  ],
  "tools": [
    {
      "name": "datasets",
      "displayName": "datasets",
      "description": "nsw-data datasets",
      "command": "nsw-data-cli datasets"
    },
    {
      "name": "dataset",
      "displayName": "dataset",
      "description": "nsw-data dataset",
      "command": "nsw-data-cli dataset"
    }
  ],
  "skill": "SKILL.md",
  "proof": "PRUEFPROTOKOLL.md",
  "x-servas": {
    "schema": "servas.record.v1",
    "category": "opendata",
    "realtime": false,
    "source_url": "https://data.nsw.gov.au/data/api/3/action/package_search",
    "access_chain": [
      "official_api",
      "dump",
      "json_endpoint",
      "html",
      "headless"
    ],
    "access_used": "official_api",
    "login": false,
    "rate_limit": "1 Request / 2 s pro Host",
    "robots_status": "ok",
    "robots": "data.nsw.gov.au/robots.txt: Disallow nur /core/ (Drupal) – /data/api/3/action/ nicht gesperrt. Drossel ≥2 s.",
    "tos": "NSW Government Open Data (CC-BY); Fair Use der CKAN API.",
    "logo": {
      "domain": "data.nsw.gov.au",
      "chain": [
        "logo.dev",
        "brandfetch",
        "google",
        "duckduckgo",
        "iconhorse",
        "direct"
      ],
      "resolved": "https://www.google.com/s2/favicons?domain=data.nsw.gov.au&sz=128",
      "fallback": "initials",
      "file": "assets/logos/data.nsw.gov.au.png"
    },
    "interfaces": [
      "paperclip",
      "cli"
    ],
    "kpis": {
      "stabilitaet": 0.0,
      "latenz_ms": 0,
      "throughput_rps": 0,
      "captcha_rate": 0,
      "login": false,
      "api_version": "ckan-3",
      "last_scrape": null,
      "datenqualitaet": 0.0
    },
    "openui": {
      "card": {
        "title": "NSW Open Data (CKAN)",
        "subtitle": "opendata",
        "icon": "logo",
        "badges": [
          "robots_status",
          "login",
          "realtime"
        ]
      },
      "list": {
        "columns": [
          "id",
          "title"
        ]
      },
      "detail": {
        "fields": [
          "kpis",
          "access_chain",
          "robots",
          "source_url"
        ]
      }
    },
    "country": "AU",
    "ampel": "grün",
    "license": "CC-BY",
    "logo_source": "favicon"
  }
}