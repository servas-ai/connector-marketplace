  "author": "servas-ai",
  "categories": [
    "connector",
    "opendata"
  ],
  "capabilities": [
    "agent.tools.register"
  ],
  "tools": [
    {
      "name": "datasets",
      "displayName": "datasets",
      "description": "andmed-ee datasets",
      "command": "andmed-ee-cli datasets"
    },
    {
      "name": "dataset",
      "displayName": "dataset",
      "description": "andmed-ee dataset",
      "command": "andmed-ee-cli dataset"
    }
  ],
  "skill": "SKILL.md",
  "proof": "PRUEFPROTOKOLL.md",
  "x-servas": {
    "schema": "servas.record.v1",
    "category": "opendata",
    "realtime": false,
    "source_url": "https://andmed.eesti.ee/api/datasets",
    "access_chain": [
      "official_api",
      "dump",
      "json_endpoint",
      "html",
      "headless"
    ],
    "access_used": "official_api",
    "login": false,
    "rate_limit": "1 Request / 2 s pro Host",
    "robots_status": "ok",
    "robots": "andmed.eesti.ee/robots.txt: 404 (keine Einschränkung). Öffentliche Portal-API /api/datasets. Drossel ≥2 s.",
    "tos": "Republik Estland – Open Data, Lizenz je Datensatz (meist CC BY 4.0).",
    "logo": {
      "domain": "andmed.eesti.ee",
      "chain": [
        "logo.dev",
        "brandfetch",
        "google",
        "duckduckgo",
        "iconhorse",
        "direct"
      ],
      "resolved": "https://www.google.com/s2/favicons?domain=andmed.eesti.ee&sz=128",
      "fallback": "initials",
      "file": "assets/logos/andmed.eesti.ee.png"
    },
    "interfaces": [
      "paperclip",
      "cli"
    ],
    "kpis": {
      "stabilitaet": 0.0,
      "latenz_ms": 0,
      "throughput_rps": 0,
      "captcha_rate": 0,
      "login": false,
