      "last_scrape": null,
      "datenqualitaet": 0.0
    },
    "openui": {
      "card": {
        "title": "Estnisches Open-Data-Portal (andmed.eesti.ee)",
        "subtitle": "opendata",
        "icon": "logo",
        "badges": [
          "robots_status",
          "login",
          "realtime"
        ]
      },
      "list": {
        "columns": [
          "id",
          "title"
        ]
      },
      "detail": {
        "fields": [
          "kpis",
          "access_chain",
          "robots",
          "source_url"
        ]
      }
    }
