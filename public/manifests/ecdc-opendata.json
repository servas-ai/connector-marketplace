{
  "id": "servas-ai.opencli-ecdc-opendata",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "OpenCLI ecdc-opendata",
  "description": "Wöchentliche Daten des ECDC zu Atemwegsinfekten (ILI/ARI, SARI, Testpositivität, Influenza-Subtypen, SARS-CoV-2-Varianten) je EU-Land aus dem offiziellen ECDC-Repository. Ohne Login. Nutze diesen Skill, wenn ein Agent Gesundheitsdaten aus dieser Quelle braucht.",
  "author": "servas-ai (Health Connector Builder)",
  "categories": [
    "connector",
    "ui",
    "gesundheit"
  ],
  "capabilities": [
    "agent.tools.register",
    "ui.page.register",
    "ui.dashboardWidget.register"
  ],
  "entrypoints": {
    "worker": "./dist/worker.js",
    "ui": "./dist/ui"
  },
  "tools": [
    {
      "name": "ecdc-opendata-daten",
      "displayName": "ecdc-opendata daten",
      "description": "CLI-Befehl `daten` (node bin/cli.js daten --format json)",
      "parametersSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "ui": {
    "slots": [
      {
        "type": "page",
        "id": "table",
        "displayName": "ecdc-opendata",
        "exportName": "RecordsPage",
        "routePath": "opencli-ecdc-opendata"
      },
      {
        "type": "dashboardWidget",
        "id": "kpis",
        "displayName": "ecdc-opendata KPIs",
        "exportName": "KpiWidget",
        "openui": "paperclip/openui.txt"
      }
    ]
  },
