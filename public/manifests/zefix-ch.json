{
  "id": "servas-ai.connector-zefix-ch",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "Zefix CH (UID-Register)",
  "description": "Schweizer Firmen/Handelsregister-Kerndaten über das offizielle UID-Register PublicServices; zefix.admin.ch ist blocked_robots.",
  "author": "servas-ai",
  "categories": [
    "connector"
  ],
  "tags": [
    "international",
    "register",
    "ch"
  ],
  "capabilities": [
    "agent.tools.register"
  ],
  "tools": [
    {
      "name": "suche",
      "displayName": "Zefix CH (UID-Register) – suche",
      "description": "Firmensuche nach Name, optional Ort/PLZ/Kanton/Rechtsform",
      "command": "node bin/cli.js suche --name \"Migros\" --kanton ZH --limit 5 --format json"
    },
    {
      "name": "uid",
      "displayName": "Zefix CH (UID-Register) – uid",
      "description": "Firma per CHE-UID",
      "command": "node bin/cli.js uid --uid CHE-105.829.940 --format json"
    },
    {
      "name": "pruefen",
      "displayName": "Zefix CH (UID-Register) – pruefen",
      "description": "UID- und MWST-Nummer prüfen",
      "command": "node bin/cli.js pruefen --uid CHE-105.829.940 --format json"
    },
    {
      "name": "robots",
      "displayName": "Zefix CH (UID-Register) – robots",
      "description": "robots.txt-Status Zefix/UID-WS anzeigen",
      "command": "node bin/cli.js robots --format json"
    }
  ],
  "access": {
    "method": "official-api",
    "login": false,
    "apiKey": false,
    "endpoint": "https://www.uid-wse.admin.ch/V5.0/PublicServices.svc",
    "protocol": "SOAP",
    "rateLimit": "20/min",
    "robots": {
      "www.zefix.admin.ch": "blocked_robots (Disallow: /)",
      "www.uid-wse.admin.ch": "kein robots.txt (404)"
    }
  },
  "logo": "../logo.png",
  "skill": "SKILL.md",
  "proof": "PRUEFPROTOKOLL.md",
  "x-servas": {
    "logo": {
      "domain": "www.uid-wse.admin.ch",
      "file": "assets/logos/www.uid-wse.admin.ch.svg"
    },
    "country": "CH",
    "ampel": "gelb",
    "license": "unbekannt",
    "logo_source": "svg"
  }
}