      "name": "suche-fortinet",
      "displayName": "suche",
      "description": "NIST NVD – CVE-Datenbank & Hersteller-Statistik: suche",
      "command": "nvd-cli suche --q fortinet --limit 5 --format json"
    },
    {
      "name": "cve-log4shell",
      "displayName": "cve",
      "description": "NIST NVD – CVE-Datenbank & Hersteller-Statistik: cve",
      "command": "nvd-cli cve CVE-2021-44228 --format json"
    },
    {
      "name": "statistik-cisco",
      "displayName": "statistik",
      "description": "NIST NVD – CVE-Datenbank & Hersteller-Statistik: statistik",
      "command": "nvd-cli statistik --q cisco --tage 90 --format json"
    }
  ],
