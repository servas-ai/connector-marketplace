    },
    {
      "name": "taf",
      "displayName": "taf",
      "description": "aviationweather taf",
      "command": "aviationweather-cli taf"
    },
    {
      "name": "station",
      "displayName": "station",
      "description": "aviationweather station",
      "command": "aviationweather-cli station"
    }
