{
  "name": "connector-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "dev": "vite",
    "build": "node scripts/gen-llms.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "screenshot": "node scripts/screenshot.mjs",
    "enrich": "node scripts/enrich.mjs",
    "enrich:offline": "node scripts/enrich.mjs --offline && node scripts/signals.mjs",
    "netintel": "node scripts/netintel.mjs",
    "signals": "node scripts/signals.mjs",
    "typecheck": "tsc -b --noEmit",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "deploy": "bash scripts/deploy-pages.sh",
    "gates": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e && npm run lighthouse"
  },
  "dependencies": {
    "@openuidev/react-lang": "^1.0.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
